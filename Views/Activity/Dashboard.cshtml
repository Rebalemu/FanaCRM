@model FanaCRM.ViewModels.ActivityDashboardVM

@{
    ViewData["Title"] = "Activity Dashboard";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold">
                <i class="bi bi-speedometer2"></i>
                Activity Dashboard
            </h3>

            <small class="text-muted">
                Overview of your activities and follow-ups
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            New Activity
        </a>

    </div>

    <!-- STATS -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Activities</h6>
                    <h2>@Model.TotalActivities</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>
                    <h2>@Model.PendingActivities</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6 class="text-muted">Completed Today</h6>
                    <h2>@Model.CompletedToday</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6 class="text-muted">Overdue</h6>
                    <h2 class="text-danger">
                        @Model.OverdueActivities
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- OVERDUE -->
    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                Overdue Activities
            </h5>
        </div>

        <div class="card-body">

            @if (Model.OverdueList.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.OverdueList)
                            {
                                <tr>

                                    <td>
                                        @item.Subject
                                    </td>

                                    <td>
                                        @item.TypeName
                                    </td>

                                    <td class="text-danger">
                                        @item.DueDate?.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @item.Status
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-muted">
                    No overdue activities.
                </div>
            }

        </div>

    </div>

    <!-- UPCOMING -->
    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Upcoming Activities
            </h5>
        </div>

        <div class="card-body">

            @if (Model.UpcomingActivities.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.UpcomingActivities)
                            {
                                <tr>

                                    <td>
                                        @item.Subject
                                    </td>

                                    <td>
                                        @item.TypeName
                                    </td>

                                    <td>
                                        @item.DueDate?.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @item.Status
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-muted">
                    No upcoming activities.
                </div>
            }

        </div>

    </div>

</div>