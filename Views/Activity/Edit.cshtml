@model FanaCRM.ViewModels.ActivityFormVM

@{
    ViewData["Title"] = "Edit Activity";

}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <!-- HEADER -->
        <div class="card-header bg-warning">

            <div class="d-flex justify-content-between align-items-center">

                <h4 class="mb-0 text-dark">

                    <i class="bi bi-pencil-square"></i>
                    Edit Activity

                </h4>

                <a asp-action="Index" class="btn btn-dark btn-sm">

                    <i class="bi bi-arrow-left"></i>
                    Back

                </a>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- TYPE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="TypeId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="TypeId" asp-items="Model.Types" class="form-select searchable-dropdown">

                            <option value="">-- Select Type --</option>

                        </select>

                    </div>

                    <!-- STATUS -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StatusId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select searchable-dropdown">

                            <option value="">-- Select Status --</option>

                        </select>

                    </div>

                    <!-- SUBJECT -->
                    <div class="col-12 mb-3">

                        <label asp-for="Subject" class="form-label fw-semibold">
                        </label>

                        <input asp-for="Subject" class="form-control" />

                    </div>

                    <!-- DESCRIPTION -->
                    <div class="col-12 mb-3">

                        <label asp-for="Description" class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description" rows="4" class="form-control">
                        </textarea>

                    </div>

                    <!-- COMPANY -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CompanyId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="CompanyId" asp-items="Model.Companies" class="form-select searchable-dropdown">

                            <option value="">-- Select Company --</option>

                        </select>

                    </div>

                    <!-- CONTACT -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="ContactId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="ContactId" asp-items="Model.Contacts" class="form-select searchable-dropdown">

                            <option value="">-- Select Contact --</option>

                        </select>

                    </div>

                    <!-- LEAD -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="LeadId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="LeadId" asp-items="Model.Leads" class="form-select searchable-dropdown">

                            <option value="">-- Select Lead --</option>

                        </select>

                    </div>

                    <!-- OPPORTUNITY -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="OpportunityId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="OpportunityId" asp-items="Model.Opportunities"
                                class="form-select searchable-dropdown">

                            <option value="">-- Select Opportunity --</option>

                        </select>

                    </div>

                    <!-- ASSIGNED -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="AssignedToId" class="form-label fw-semibold">
                        </label>

                        <select asp-for="AssignedToId" asp-items="Model.Users" class="form-select searchable-dropdown">

                            <option value="">-- Select User --</option>

                        </select>

                    </div>

                    <!-- DUE DATE -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="DueDate" class="form-label fw-semibold">
                        </label>

                        <input asp-for="DueDate" type="datetime-local" class="form-control" />

                    </div>

                </div>

                <hr />

                <div class="text-end">

                    <button type="submit" class="btn btn-warning px-4">

                        <i class="bi bi-check-circle"></i>
                        Update Activity

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css"
          rel="stylesheet" />

    <!-- JQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

        $('#CompanyId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Company --',
        allowClear: true
        });

        $('#ContactId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Contact --',
        allowClear: true
        });

        $('#AssignedToId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select User --',
        allowClear: true
        });

        $('#LeadId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Lead --',
        allowClear: true
        });

        $('#OpportunityId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Opportunity --',
        allowClear: true
        });

        $('#TypeId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Type --',
        allowClear: true
        });

        $('#StatusId').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: '-- Select Status --',
        allowClear: true
        });

        });

    </script>

}