@model List<FanaCRM.ViewModels.ActivityIndexVM>

@{
    ViewData["Title"] = "Activities";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-activity"></i>
                Activity Management

            </h3>

            <small class="text-muted">

                Manage calls, meetings, tasks, and follow-ups

            </small>

        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">

            <i class="bi bi-plus-circle"></i>
            New Activity

        </a>

    </div>

    <!-- CARD -->
    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table id="activityTable" class="table table-hover align-middle w-100">

                    <!-- HEAD -->
                    <thead class="table-dark">

                        <tr>

                            <th>Subject</th>

                            <th>Type</th>

                            <th>Company</th>

                            <th>Contact</th>

                            <th>Assigned</th>

                            <th>Due Date</th>

                            <th>Status</th>

                            <th class="text-end">Actions</th>

                        </tr>

                    </thead>

                    <!-- BODY -->
                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- SUBJECT -->
                                    <td class="fw-semibold">

                                        @item.Subject

                                    </td>

                                    <!-- TYPE -->
                                    <td>

                                        <span class="badge bg-secondary">

                                            @item.TypeName

                                        </span>

                                    </td>

                                    <!-- COMPANY -->
                                    <td>

                                        @(item.CompanyName ?? "N/A")

                                    </td>

                                    <!-- CONTACT -->
                                    <td>

                                        @(item.ContactName ?? "N/A")

                                    </td>

                                    <!-- ASSIGNED -->
                                    <td>

                                        @item.AssignedTo

                                    </td>

                                    <!-- DUE DATE -->
                                    <td>

                                        @(item.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")

                                        @if (item.DueDate < DateTime.Now
                                                                               && !item.IsCompleted)
                                        {
                                            <span class="badge bg-danger ms-1">

                                                Overdue

                                            </span>
                                        }

                                    </td>

                                    <!-- STATUS -->
                                    <td>

                                        @{
                                            var statusClass = item.Status switch
                                            {
                                                "Open" => "bg-primary",
                                                "Completed" => "bg-success",
                                                "Cancelled" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }

                                        <span class="badge @statusClass">

                                            @item.Status

                                        </span>

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-end">

                                        <div class="btn-group">

                                            <!-- DETAILS -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <!-- EDIT -->
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- COMPLETE -->
                                            @if (!item.IsCompleted)
                                            {
                                                <form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline">

                                                    <button class="btn btn-sm btn-success">

                                                        <i class="bi bi-check-circle"></i>

                                                    </button>

                                                </form>
                                            }

                                            <!-- CANCEL -->
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">

                                                <button class="btn btn-sm btn-danger">

                                                    <i class="bi bi-x-circle"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8" class="text-center py-5 text-muted">

                                    No activities found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $('#activityTable').DataTable({

                responsive: true,
                autoWidth: false,
                pageLength: 10,
                order: [[5, 'desc']],

                columnDefs: [
                    {
                        orderable: false,
                        targets: 7
                    }
                ]

            });

        });

    </script>

}