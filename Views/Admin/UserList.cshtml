@using FanaCRM.ViewModels
@model List<UserVM>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<!-- TOAST / ALERTS -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-people-fill"></i>
                User Management
            </h3>

            <small class="text-muted">
                Manage system users and roles
            </small>
        </div>

        <a asp-controller="Account" asp-action="Register" class="btn btn-primary shadow-sm">

            <i class="bi bi-plus-circle"></i>
            Create User

        </a>

    </div>

    <!-- CARD -->
    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table id="usersTable" class="table table-hover table-striped align-middle w-100">

                    <!-- HEADER -->
                    <thead class="table-dark">

                        <!-- FILTER ROW -->
                        <tr>

                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       placeholder="Search ID" />
                            </th>

                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       placeholder="Search Name" />
                            </th>

                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       placeholder="Search Email" />
                            </th>

                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       placeholder="Search Role" />
                            </th>

                            <th>Actions</th>

                        </tr>


                    </thead>

                    <!-- BODY -->
                    <tbody>

                        @foreach (var obj in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="text-muted">
                                    @obj.Id
                                </td>

                                <!-- FULL NAME -->
                                <td class="fw-semibold">
                                    @obj.FullName
                                </td>

                                <!-- EMAIL -->
                                <td>
                                    @obj.Email
                                </td>

                                <!-- ROLES -->
                                <td>
                                    @foreach (var role in obj.Roles)
                                    {
                                        <span class="badge bg-success me-1">
                                            @role
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-controller="Admin" asp-action="EditRole" asp-route-id="@obj.Id"
                                               class="btn btn-sm btn-warning">

                                            <i class="bi bi-pencil-square"></i>Edit

                                        </a>

                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                                data-bs-target="#deleteUserModal-@obj.Id">

                                            <i class="bi bi-trash-fill"></i>Delete

                                        </button>

                                    </div>

                                    @await Html.PartialAsync("_DeleteUser", obj)

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            var table = $('#usersTable').DataTable({

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                order: [[1, 'asc']], // sort by name

                columnDefs: [
                    {
                        orderable: false,
                        targets: 4
                    }
                ],

                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search users..."
                }

            });

            // COLUMN SEARCH
            $('#usersTable thead tr:eq(0) th').each(function (i) {

                $('input', this).on('keyup change', function () {

                    if (table.column(i).search() !== this.value) {

                        table
                            .column(i)
                            .search(this.value)
                            .draw();

                    }

                });

            });

        });

    </script>

}