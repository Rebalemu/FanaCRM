@model FanaCRM.ViewModels.CompanyCreateVM

@{
    ViewData["Title"] = "Create Company";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Create Company</h3>
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="row">

                    <!-- Company Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Industry -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Industry" class="form-label"></label>
                        <input asp-for="Industry" class="form-control" placeholder="Enter industry (optional)" />
                        <span asp-validation-for="Industry" class="text-danger"></span>
                    </div>

                    <!-- Website -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Website" class="form-label"></label>
                        <input asp-for="Website" class="form-control" placeholder="https://example.com" />
                        <span asp-validation-for="Website" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" placeholder="Enter address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="bi bi-check-circle"></i> Save
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}