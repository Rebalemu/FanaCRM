@model List<FanaCRM.Models.Company>

@{
    ViewData["Title"] = "Companies";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Company Management</h3>
        <a asp-action="Create" class="btn btn-primary">+ New Company</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Search -->
            <form method="get" class="row mb-3">
                <div class="col-md-4">
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control"
                           placeholder="Search by company name..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </form>

            <!-- Table -->
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Industry</th>
                        <th>Website</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>

                                <td>
                                    @(string.IsNullOrEmpty(item.Industry) ? "N/A" : item.Industry)
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Website))
                                    {
                                        <a href="@item.Website" target="_blank">
                                            Visit
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td>@item.Phone</td>

                                <td>@item.Address</td>

                                <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning mx-1">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info mx-1">
                                            <i class="bi bi-eye-fill"></i> View
                                        </a>

                                        <button type="button" class="btn btn-sm btn-danger mx-1" data-bs-toggle="modal"
                                                data-bs-target="#deleteModal" data-id="@item.Id">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No companies found. Try adjusting your search.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")