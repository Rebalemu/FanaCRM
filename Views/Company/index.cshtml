@model List<FanaCRM.Models.Company>

@{
    ViewData["Title"] = "Companies";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-buildings-fill"></i>
                Company Management
            </h3>

            <small class="text-muted">
                Manage all companies and business accounts
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">

            <i class="bi bi-plus-circle"></i>
            New Company

        </a>

    </div>

    <!-- CARD -->
    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table id="companyTable" class="table table-hover table-striped align-middle w-100">

                    <!-- TABLE HEADER -->
                    <thead class="table-dark">

                        <!-- FILTER ROW -->
                        <tr>

                            <!-- NAME -->
                            <th>
                                <input type="text" placeholder="Search Name"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- INDUSTRY -->
                            <th>
                                <select class="form-select form-select-sm searchable-dropdown">
                                    <option value="">All Industries</option>
                                </select>
                            </th>

                            <!-- WEBSITE -->
                            <th>
                                <input type="text" placeholder="Search Website"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- PHONE -->
                            <th>
                                <input type="text" placeholder="Search Phone"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- ADDRESS -->
                            <th>
                                <input type="text" placeholder="Search Address"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- CREATED -->
                            <th>
                                <input type="text" placeholder="Created Date"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- ACTION -->
                            <th>Actions</th>

                        </tr>

                      

                    </thead>

                    <!-- TABLE BODY -->
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- NAME -->
                                    <td class="fw-semibold">

                                        @item.Name

                                    </td>

                                    <!-- INDUSTRY -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.Industry))
                                        {
                                            <span class="badge bg-info">
                                                @item.Industry
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- WEBSITE -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.Website))
                                        {
                                            <a href="@item.Website" target="_blank" class="text-decoration-none">

                                                @item.Website

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- PHONE -->
                                    <td>

                                        @(string.IsNullOrEmpty(item.Phone)
                                            ? "N/A"
                                            : item.Phone)

                                    </td>

                                    <!-- ADDRESS -->
                                    <td>

                                        @(string.IsNullOrEmpty(item.Address)
                                            ? "N/A"
                                            : item.Address)

                                    </td>

                                    <!-- CREATED -->
                                    <td>

                                        @item.CreatedDate.ToString("yyyy-MM-dd")

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-end">

                                        <div class="btn-group">

                                            <!-- EDIT -->
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- DETAILS -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <!-- DELETE -->
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal" data-id="@item.Id">

                                                <i class="bi bi-trash-fill"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7" class="text-center text-muted py-4">

                                    No companies found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {

    <script>

        $(document).ready(function () {

            // SELECT2
            $('.searchable-dropdown').select2({

                theme: 'bootstrap-5',

                width: '100%',

                placeholder: 'Select',

                allowClear: true

            });

            // DATATABLE
            var table = $('#companyTable').DataTable({

                responsive: true,

                autoWidth: false,

                orderCellsTop: true,

                fixedHeader: true,

                pageLength: 10,

                order: [[5, 'desc']],

                columnDefs: [
                    {
                        orderable: false,
                        targets: 6
                    }
                ],

                language: {

                    search: "_INPUT_",

                    searchPlaceholder: "Global Search..."

                },

                initComplete: function () {

                    var api = this.api();

                    // INDUSTRY FILTER
                    createDropdownFilter(api, 1);

                }

            });

            // =====================================
            // TEXT FILTERS
            // =====================================

            $('#companyTable thead tr:eq(0) th').each(function (i) {

                var input = $(this).find('input');

                if (input.length > 0) {

                    $(input).on('keyup change', function () {

                        if (table.column(i).search() !== this.value) {

                            table
                                .column(i)
                                .search(this.value)
                                .draw();

                        }

                    });

                }

            });

            // =====================================
            // DROPDOWN FILTERS
            // =====================================

            function createDropdownFilter(api, columnIndex) {

                var column = api.column(columnIndex);

                var select = $('#companyTable thead tr:eq(0) th')
                    .eq(columnIndex)
                    .find('select');

                // UNIQUE VALUES
                column.data().unique().sort().each(function (d) {

                    var text = $('<div>').html(d).text().trim();

                    if (text !== '') {

                        select.append(
                            `<option value="${text}">${text}</option>`
                        );

                    }

                });

                // FILTER EVENT
                select.on('change', function () {

                    var value = $(this).val();

                    column
                        .search(value)
                        .draw();

                });

            }

        });

    </script>

}