@model FanaCRM.ViewModels.OpportunityFormVM

@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5>Edit Opportunity</h5>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                <partial name="_Form" model="Model" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @await Html.PartialAsync("_OpportunityScripts", Model)
}