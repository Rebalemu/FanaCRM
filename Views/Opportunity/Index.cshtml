@model List<FanaCRM.ViewModels.OpportunityIndexVM>

@{
    ViewData["Title"] = "Opportunities";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-briefcase-fill"></i>
                Opportunity Management
            </h3>

            <small class="text-muted">
                Track sales pipeline and deal progress
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">

            <i class="bi bi-plus-circle"></i>
            New Opportunity

        </a>

    </div>

    <!-- CARD -->
    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table id="opportunityTable" class="table table-hover table-striped align-middle w-100">

                    <!-- TABLE HEADER -->
                    <thead class="table-dark">

                        <!-- FILTER ROW -->
                        <tr>

                            <!-- NAME -->
                            <th>
                                <input type="text" placeholder="Search Opportunity"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- COMPANY -->
                            <th>
                                <input type="text" placeholder="Search Company"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- STAGE -->
                            <th>
                                <select class="form-select form-select-sm searchable-dropdown">
                                    <option value="">All Stages</option>
                                </select>
                            </th>

                            <!-- AMOUNT -->
                            <th>
                                <input type="text" placeholder="Search Amount"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- CLOSE DATE -->
                            <th>
                                <input type="text" placeholder="Close Date"
                                       class="form-control form-control-sm column-search" />
                            </th>

                            <!-- ASSIGNED -->
                            <th>
                                <select class="form-select form-select-sm searchable-dropdown">
                                    <option value="">All Users</option>
                                </select>
                            </th>

                            <!-- ACTION -->
                            <th>Actions</th>

                        </tr>


                    </thead>

                    <!-- TABLE BODY -->
                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7" class="text-center text-muted py-4">

                                    No opportunities found

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- NAME -->
                                    <td class="fw-semibold">

                                        @item.Name

                                    </td>

                                    <!-- COMPANY -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.CompanyName))
                                        {
                                            <span class="badge bg-secondary">
                                                @item.CompanyName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- STAGE -->
                                    <td>

                                        @{
                                            var badgeClass = item.StageName switch
                                            {
                                                "Prospect" => "bg-secondary",
                                                "Qualified" => "bg-info",
                                                "Proposal" => "bg-primary",
                                                "Negotiation" => "bg-warning",
                                                "Won" => "bg-success",
                                                "Lost" => "bg-danger",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badgeClass">

                                            @item.StageName
                                            (@item.Probability%)

                                        </span>

                                    </td>

                                    <!-- AMOUNT -->
                                    <td>

                                        @{
                                            var amountClass = item.StageName == "Won"
                                                ? "fw-bold text-success"
                                                : "fw-bold text-warning";
                                        }

                                        <span class="@amountClass">

                                            $@item.Amount.ToString("N2")

                                        </span>

                                    </td>

                                    <!-- CLOSE DATE -->
                                    <td>

                                        @(item.CloseDate?.ToString("yyyy-MM-dd") ?? "-")

                                    </td>

                                    <!-- ASSIGNED -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(item.AssignedTo))
                                        {
                                            <span class="badge bg-dark">

                                                @item.AssignedTo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                Unassigned

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-start">

                                        <div class="btn-group">

                                            <!-- EDIT -->
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- DETAILS -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <!-- DELETE -->
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal" data-id="@item.Id">

                                                <i class="bi bi-trash-fill"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {

    <script>

        $(document).ready(function () {

            // =========================================
            // DATATABLE
            // =========================================

            var table = $('#opportunityTable').DataTable({

                responsive: true,
                autoWidth: false,
                orderCellsTop: true,
                fixedHeader: true,
                pageLength: 10,
                order: [[4, 'asc']],

                columnDefs: [
                    {
                        orderable: false,
                        targets: 6
                    }
                ],

                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Global Search..."
                },

                initComplete: function () {

                    var api = this.api();

                    // CREATE FILTERS
                    createDropdownFilter(api, 2); // Stage
                    createDropdownFilter(api, 5); // Assigned To

                    // INIT SELECT2 AFTER OPTIONS LOADED
                    $('.searchable-dropdown').select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        placeholder: 'Select',
                        allowClear: true
                    });

                }

            });

            // =========================================
            // TEXT SEARCH
            // =========================================

            $('#opportunityTable thead tr:eq(0) th').each(function (i) {

                var input = $(this).find('input');

                if (input.length) {

                    input.on('keyup change', function () {

                        if (table.column(i).search() !== this.value) {

                            table
                                .column(i)
                                .search(this.value)
                                .draw();

                        }

                    });

                }

            });

            // =========================================
            // DROPDOWN FILTER
            // =========================================

            function createDropdownFilter(api, columnIndex) {

                var column = api.column(columnIndex);

                var select = $('#opportunityTable thead tr:eq(0) th')
                    .eq(columnIndex)
                    .find('select');

                // CLEAR OLD OPTIONS EXCEPT FIRST
                select.find('option:not(:first)').remove();

                // GET UNIQUE CLEAN VALUES
                var uniqueValues = [];

                column.nodes().each(function (cell) {

                    var text = $(cell).text().trim();

                    if (text && !uniqueValues.includes(text)) {

                        uniqueValues.push(text);

                    }

                });

                uniqueValues.sort();

                // APPEND OPTIONS
                uniqueValues.forEach(function (value) {

                    select.append(
                        `<option value="${value}">${value}</option>`
                    );

                });

                // FILTER
                select.on('change', function () {

                    var value = $.fn.dataTable.util
                        .escapeRegex($(this).val());

                    column
                        .search(value ? value : '', true, false)
                        .draw();

                });

            }

        });

    </script>

}