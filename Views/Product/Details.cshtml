@model FanaCRM.ViewModels.ProductVMs.ProductDetailsVM

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Product Details</h3>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    <div class="card p-4">
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Name:</strong>
                <div>@Model.Name</div>
            </div>

            <div class="col-md-6">
                <strong>Price:</strong>
                <div class="text-success">@Model.Price.ToString("N2")</div>
            </div>
        </div>

        <div class="mb-3">
            <strong>Description:</strong>
            <div>@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</div>
        </div>

        <div class="mb-3">
            <strong>Status:</strong>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div>
            <strong>Opportunities Linked:</strong>
            <span class="badge bg-info">@Model.OpportunityCount</span>
        </div>
    </div>

</div>